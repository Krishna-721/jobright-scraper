# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local credentials and browser authentication state
.env
.env.*
!.env.example
auth/auth_state.json
config/auth_state.json

# Playwright persistent browser profile (cookies, cache, and local state)
session/

# Scraper output and runtime logs
output/*
!output/.gitkeep
logs/
*.log

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
